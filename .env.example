# Cybernoetica -- Local Development Overrides
# Copy to .env.local and uncomment what you need.
# All variables are optional; the app works without any of them.

# ─── GitHub / Admin ─────────────────────────────────────────────────────
# Override the GitHub token (defaults to `gh auth token` via the JUSTFile).
# GITHUB_TOKEN=ghp_...

# ─── Deployment Target ──────────────────────────────────────────────────
# Override the host used by `just upload` / `just list-tracks`.
# DEPLOY_HOST=https://cybernoetica-web-demo.up.railway.app

# ─── Demo Auth Gate (local testing) ─────────────────────────────────────
# Set these to test the email+password login locally.
# GATE_PASSWORD=test123
# APPROVED_EMAILS=you@example.com
# SESSION_SECRET=local-dev-secret

# ─── Audio Setup / Configuration ────────────────────────────────────────
# Override the audio directory path.
# AUDIO_DIR=/path/to/your/audio/files
