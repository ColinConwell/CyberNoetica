{
  "name": "@cybernoetica/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "pnpm exec esbuild server.ts --bundle --platform=node --format=esm --outfile=server.mjs --packages=external",
    "preview": "vite preview",
    "serve": "node server.mjs",
