    "cookie-session": "^2.1.1",
    "express": "^5.2.1",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/three": "^0.175.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.1"
  }
}
