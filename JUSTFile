# Cybernoetica -- Development Commands
# Usage: just <command>

set dotenv-filename := ".env.local"

github_token := env("GITHUB_TOKEN", `gh auth token 2>/dev/null || echo ""`)
deploy_host  := env("DEPLOY_HOST", "https://cybernoetica-web-demo.up.railway.app")

# Default: show available commands
default:
    @just --list

# ─── Launch ───────────────────────────────────────────────────────────

# Start the dev server (Vite, port 5173)
dev:
    pnpm dev

# Start dev server with debug panel enabled
dev-debug:
    pnpm dev -- --open "http://localhost:5173?debug"

# Start dev server and open in default browser
launch:
    pnpm dev &
    sleep 2
    open http://localhost:5173

# Start dev server with specific visualizer, audio source, and/or settings
# Examples:
#   just launch-with viz=mandelbrot
#   just launch-with audio=system
#   just launch-with viz=orbital audio=system log=stream
launch-with +params="":
    #!/usr/bin/env bash
    query=""
    for kv in {{params}}; do
        key="${kv%%=*}"
        val="${kv#*=}"
        [ -n "$query" ] && query="${query}&"
        query="${query}${key}=${val}"
    done
    url="http://localhost:5173"
    [ -n "$query" ] && url="${url}?${query}"
    pnpm dev &
    sleep 2
    open "$url"

# Launch via the centralized launch script (supports --viz, --audio, --log, --debug, etc.)
# Examples:
#   just run --viz mandelbrot --audio system
#   just run --debug --log stream
#   just run --prod
run +args="":
    ./launch.sh {{args}}

# ─── Build ────────────────────────────────────────────────────────────

# Build all packages
build:
    pnpm build

# Build the Rust/WASM audio analysis module
wasm:
    cd crates/audio-analysis && wasm-pack build --target web --out-dir ../../packages/audio/wasm

# ─── Test ─────────────────────────────────────────────────────────────

# Run all Vitest tests (58 tests across 4 packages; use test-rust for Rust)
test:
    pnpm test

# Run tests in watch mode (core + renderer + audio)
test-watch:
    pnpm --filter @cybernoetica/core test:watch &
    pnpm --filter @cybernoetica/renderer test:watch &
    pnpm --filter @cybernoetica/audio test:watch

# Run only Rust tests
test-rust:
    cd crates/audio-analysis && cargo test

# ─── Test / Dev Modes ─────────────────────────────────────────────────

# Launch a muted visualizer test (audio drives visuals, no speaker output)
# Examples:
#   just test-viz                          # random viz + random track, muted
#   just test-viz viz=mandelbrot           # specific viz, random track, muted
#   just test-viz viz=orbital audio=system # specific viz + audio source, muted
test-viz +params="":
    #!/usr/bin/env bash
    args="--mute --autostart"
    for kv in {{params}}; do
        key="${kv%%=*}"
        val="${kv#*=}"
        args="$args --$key $val"
    done
    ./launch.sh $args

# ─── Install ──────────────────────────────────────────────────────────

# Install all dependencies
install:
    pnpm install

# Full setup: install deps + build WASM
setup:
    pnpm install
    just wasm

# ─── Deploy ──────────────────────────────────────────────────────────

# Build the production Express server
build-server:
    pnpm --filter @cybernoetica/web build:server

# Build SPA + server for production
build-prod:
    pnpm build
    just build-server

# Run the production server locally (build first with `just build-prod`)
serve:
    cd apps/web && node server.mjs

# Deploy to Railway and verify tracks afterward
deploy:
    #!/usr/bin/env bash
    railway up
    echo ""
    echo "Waiting for deployment to stabilize..."
    sleep 15
    echo "Verifying tracks..."
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh verify || \
        echo "Warning: track verification failed -- you may need to re-upload audio"

# Show Railway deployment status and logs
deploy-status:
    railway status
    @echo ""
    railway logs

# Set Railway auth gate (provide email list and password)
deploy-auth emails password:
    railway variable set "APPROVED_EMAILS={{emails}}" "GATE_PASSWORD={{password}}" --skip-deploys

# List Railway environment variables
deploy-vars:
    railway variable list

# Open Railway dashboard in browser
deploy-open:
    railway open

# ─── Audio Upload ────────────────────────────────────────────────────

# Upload a single audio file
upload file subdir="":
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh upload "{{file}}" --subdir "{{subdir}}"

# Upload all audio files from a directory
upload-dir dir subdir="":
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh upload-dir "{{dir}}" --subdir "{{subdir}}"

# List tracks on the deployed server
list-tracks:
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh list

# Verify that audio tracks are available on the server
verify-tracks:
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh verify

# Re-upload all local audio to the server (from data/sample-music/)
reupload-tracks:
    DEPLOY_HOST="{{deploy_host}}" GITHUB_TOKEN="{{github_token}}" \
        ./scripts/upload-audio.sh upload-dir data/sample-music

# ─── DNS ──────────────────────────────────────────────────────────────

# List DNS records for a domain (requires PORKBUN_API_KEY in .env.local)
dns-list domain="imbasso.com":
    ./scripts/manage-dns.sh list "{{domain}}"

# Get a specific DNS record
dns-get domain type subdomain:
    ./scripts/manage-dns.sh get "{{domain}}" "{{type}}" "{{subdomain}}"

# Update the app.imbasso.com CNAME to the current Railway routing target
dns-update-cname:
    ./scripts/manage-dns.sh update imbasso.com CNAME app wbbydzp1.up.railway.app

# List custom domains on the Railway service
railway-domains:
    ./scripts/manage-dns.sh railway-list

# Check Railway custom domain status
railway-domain-status domain="app.imbasso.com":
    ./scripts/manage-dns.sh railway-status "{{domain}}"

# Type-check without emitting (catches errors Vite misses)
typecheck:
    pnpm typecheck

# ─── Auditing ─────────────────────────────────────────────────────────

# Audit CSS transitions and animations for consistency
audit-animations:
    npx tsx scripts/audit-ui-animations.ts

# ─── Clean ────────────────────────────────────────────────────────────

# Remove build artifacts and node_modules
clean:
    rm -rf node_modules apps/web/node_modules packages/*/node_modules
    rm -rf apps/web/dist packages/*/dist apps/web/server.mjs
    rm -rf crates/audio-analysis/target

# Remove WASM build output
clean-wasm:
    rm -rf packages/audio/wasm
