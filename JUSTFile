# Cybernoetica -- Development Commands
# Usage: just <command>

set dotenv-filename := ".env.local"

github_token := env("GITHUB_TOKEN", `gh auth token 2>/dev/null || echo ""`)
deploy_host  := env("DEPLOY_HOST", "https://app.imbasso.com")

# Default: show available commands
default:
    @just --list

# ─── Launch ───────────────────────────────────────────────────────────

# Start the dev server (Vite, port 5173)
dev:
    pnpm dev

# Start dev server with debug panel enabled
dev-debug:
    pnpm dev -- --open "http://localhost:5173?debug"

# Start dev server and open in default browser
launch:
    pnpm dev &
    sleep 2
    open http://localhost:5173

# ─── Build ────────────────────────────────────────────────────────────

# Build all packages
build:
    pnpm build

# Build the Rust/WASM audio analysis module
wasm:
    cd crates/audio-analysis && wasm-pack build --target web --out-dir ../../packages/audio/wasm

# ─── Test ─────────────────────────────────────────────────────────────

# Run all tests (79 Vitest + Rust)
test:
    pnpm test

# Run tests in watch mode (core + renderer + audio)
test-watch:
    pnpm --filter @cybernoetica/core test:watch &
    pnpm --filter @cybernoetica/renderer test:watch &
    pnpm --filter @cybernoetica/audio test:watch

# Run only Rust tests
test-rust:
    cd crates/audio-analysis && cargo test

# ─── Install ──────────────────────────────────────────────────────────

# Install all dependencies
install:
    pnpm install

# Full setup: install deps + build WASM
setup:
    pnpm install
    just wasm

# ─── Deploy ──────────────────────────────────────────────────────────

# Build the production Express server
build-server:
    pnpm --filter @cybernoetica/web build:server

# Build SPA + server for production
build-prod:
    pnpm build
    just build-server

# Run the production server locally (build first with `just build-prod`)
serve:
    cd apps/web && node server.mjs

# Deploy to Railway
deploy:
    railway up

# Show Railway deployment status and logs
deploy-status:
    railway status
    @echo ""
    railway logs

# Set Railway auth gate (provide email list and password)
deploy-auth emails password:
    railway variable set "APPROVED_EMAILS={{emails}}" "GATE_PASSWORD={{password}}" --skip-deploys

# List Railway environment variables
deploy-vars:
    railway variable list

# Open Railway dashboard in browser
deploy-open:
    railway open

# ─── Audio Upload ────────────────────────────────────────────────────

# Upload a single audio file (uses gh CLI token automatically)
upload file subdir="":
    #!/usr/bin/env bash
    name=$(basename "{{file}}")
    printf "\033[1m%s\033[0m " "$name"
    resp=$(curl -s -w "\n%{http_code}" -X POST "{{deploy_host}}/api/admin/upload" \
        -H "Authorization: Bearer {{github_token}}" \
        -F "file=@{{file}}" \
        -F "subdir={{subdir}}")
    code=$(echo "$resp" | tail -1)
    body=$(echo "$resp" | sed '$d')
    if [ "$code" = "200" ]; then
        printf "\033[32mok\033[0m\n"
    else
        printf "\033[31mfailed (%s)\033[0m %s\n" "$code" "$body"
    fi

# Upload all audio files from a directory
upload-dir dir subdir="":
    #!/usr/bin/env bash
    shopt -s nullglob globstar
    files=()
    for f in "{{dir}}"/**/*.{mp3,wav,ogg,flac,aac,m4a}; do
        [ -f "$f" ] && files+=("$f")
    done
    total=${#files[@]}
    if [ "$total" -eq 0 ]; then
        echo "No audio files found in {{dir}}"
        exit 0
    fi
    echo "Uploading $total files to {{deploy_host}}"
    echo ""
    ok=0; fail=0
    for i in "${!files[@]}"; do
        f="${files[$i]}"
        n=$((i + 1))
        name=$(basename "$f")
        pct=$((n * 100 / total))
        filled=$((pct / 2))
        empty=$((50 - filled))
        bar=$(printf '%0.s#' $(seq 1 $filled 2>/dev/null) || true)
        gap=$(printf '%0.s-' $(seq 1 $empty 2>/dev/null) || true)
        printf "\r[%-50s] %3d%% (%d/%d) %s" "$bar$gap" "$pct" "$n" "$total" "$name"
        resp=$(curl -s -w "\n%{http_code}" -X POST "{{deploy_host}}/api/admin/upload" \
            -H "Authorization: Bearer {{github_token}}" \
            -F "file=@$f" \
            -F "subdir={{subdir}}")
        code=$(echo "$resp" | tail -1)
        if [ "$code" = "200" ]; then
            ok=$((ok + 1))
        else
            fail=$((fail + 1))
            body=$(echo "$resp" | sed '$d')
            printf "\n  \033[31mfailed (%s)\033[0m %s\n" "$code" "$body"
        fi
    done
    printf "\r[%-50s] 100%% (%d/%d)\n" "$(printf '%0.s#' $(seq 1 50))" "$total" "$total"
    echo ""
    echo "Done: $ok succeeded, $fail failed"

# List tracks on the deployed server
list-tracks:
    #!/usr/bin/env bash
    resp=$(curl -s -w "\n%{http_code}" "{{deploy_host}}/api/admin/tracks" \
        -H "Authorization: Bearer {{github_token}}")
    code=$(echo "$resp" | tail -1)
    body=$(echo "$resp" | sed '$d')
    if [ "$code" = "200" ]; then
        echo "$body" | python3 -m json.tool
    else
        echo "Error ($code): $body" >&2
        exit 1
    fi

# ─── Clean ────────────────────────────────────────────────────────────

# Remove build artifacts and node_modules
clean:
    rm -rf node_modules apps/web/node_modules packages/*/node_modules
    rm -rf apps/web/dist packages/*/dist apps/web/server.mjs
    rm -rf crates/audio-analysis/target

# Remove WASM build output
clean-wasm:
    rm -rf packages/audio/wasm
